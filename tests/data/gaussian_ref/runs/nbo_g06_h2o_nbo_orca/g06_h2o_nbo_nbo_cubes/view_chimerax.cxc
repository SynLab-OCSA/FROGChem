# ChimeraX script to visualize NBO surfaces
# Open with: chimerax view_chimerax.cxc
set bgColor white
open g06_h2o_nbo_nbo1_CR_O_1.cube
volume #1 level 0.0500 color #3b82f6 transparency 0.3
volume #1 level -0.0500 color #ef4444 transparency 0.3
open g06_h2o_nbo_nbo2_LP_O_1.cube
volume #2 level 0.0500 color #3b82f6 transparency 0.3
volume #2 level -0.0500 color #ef4444 transparency 0.3
